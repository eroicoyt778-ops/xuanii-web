rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sesiones activas en tiempo real ("Personas en línea")
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.updatedAtMs is number;
      allow delete: if true;
    }

    // Buzón oficial de propuestas y contacto hacia Xuanii
    match /messages/{msgId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.subject is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid
                      || request.auth.token.email == "thexsactc@gmail.com");
    }

    // Registro de acceso anticipado a PhotoStun
    match /photostun_waitlist/{entryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.priority is string;
      allow read: if request.auth != null
                  && request.auth.token.email == "thexsactc@gmail.com";
    }

    // Cuenta privada y proyectos guardados de cada usuario (PhotoStun y futuras apps)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Perfiles públicos de miembros reales para conectar y ofrecer trabajos
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 80;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Conversaciones directas en tiempo real entre usuarios
    match /conversations/{convId} {
      allow get: if request.auth != null
                 && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 3000;
      }
    }
  }
}
