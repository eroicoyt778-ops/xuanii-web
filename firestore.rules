rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCreatorUid(uid) {
      return uid == "iHw8l7jKnzPp1JDCGsJ73C9I4z73";
    }

    function isAdmin() {
      return isSignedIn() && isCreatorUid(request.auth.uid);
    }

    function isNotBanned() {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    // Lista pública de cuentas suspendidas por seguridad / fraude (solo modificable por administración)
    match /banned_users/{targetUid} {
      allow read: if true;
      allow create, update: if isAdmin() && !isCreatorUid(targetUid);
      allow delete: if isAdmin();
    }

    // Reportes de seguridad por ID interno contra estafas o abuso
    match /reports/{reportId} {
      allow create: if isNotBanned()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 1500;
      allow read, update, delete: if isAdmin();
    }

    // Sesiones activas en tiempo real ("Personas en línea")
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.updatedAtMs is number;
      allow delete: if true;
    }

    // Buzón oficial de propuestas y contacto hacia Xuanii
    match /messages/{msgId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.subject is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow read: if isSignedIn()
                  && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Registro de acceso anticipado a PhotoStun
    match /photostun_waitlist/{entryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.priority is string;
      allow read: if isAdmin();
    }

    // Cuenta privada, llaves cifradas del usuario y archivos personales
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /projects/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isNotBanned() && request.auth.uid == userId;
      }
    }

    // Validación segura de cambio de membresía
    function isValidMembershipTierUpdate(currentData, incomingData) {
      let sameTier = incomingData.membershipTier == currentData.membershipTier;
      let settingCreator = incomingData.membershipTier == 'creator';
      let tierAllowed = incomingData.membershipTier in ['standard', 'plus', 'pro'];
      return sameTier || (isAdmin() && settingCreator) || (!settingCreator && tierAllowed);
    }

    // Perfiles profesionales públicos con ID interno verificable y membresía
    match /profiles/{userId} {
      allow read: if true;
      allow create: if (isNotBanned() && request.auth.uid == userId
                        && request.resource.data.displayName is string
                        && request.resource.data.displayName.size() <= 80
                        && (!('membershipTier' in request.resource.data) || request.resource.data.membershipTier == 'standard' || isAdmin()))
                    || isAdmin();
      allow update: if (isNotBanned() && request.auth.uid == userId
                        && request.resource.data.displayName is string
                        && request.resource.data.displayName.size() <= 80
                        && (!('membershipTier' in request.resource.data) || isValidMembershipTierUpdate(resource.data, request.resource.data)))
                    || isAdmin();
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // Registro global de nombres de usuario únicos (@handle, max 25 caracteres)
    match /usernames/{handle} {
      allow read: if true;
      allow create: if isNotBanned()
                    && request.resource.data.uid == request.auth.uid
                    && handle.size() >= 3
                    && handle.size() <= 25
                    && !exists(/databases/$(database)/documents/usernames/$(handle));
      allow update: if isNotBanned()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Calificaciones reales de 1 a 5 estrellas por trabajos realizados (1 reseña única por par de usuarios)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isNotBanned()
                            && request.resource.data.reviewerUid == request.auth.uid
                            && request.resource.data.targetUid is string
                            && request.resource.data.targetUid != request.auth.uid
                            && reviewId == (request.resource.data.targetUid + "_" + request.auth.uid)
                            && request.resource.data.stars is int
                            && request.resource.data.stars >= 1
                            && request.resource.data.stars <= 5
                            && request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 1200;
      allow delete: if isSignedIn()
                    && (resource.data.reviewerUid == request.auth.uid || isAdmin());
    }

    // Publicaciones sociales ("Para ti") con fotos, videos, código y portafolio
    match /posts/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 4000
                    && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['none', 'photo', 'video', 'video_embed', 'video_native', 'code'])
                    && (!('videoUrl' in request.resource.data) || request.resource.data.videoUrl.size() <= 600);
      allow update: if isNotBanned()
                    && (resource.data.authorUid == request.auth.uid
                        || isAdmin()
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dislikes'])
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'commentCount']));
      allow delete: if isSignedIn()
                    && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isNotBanned()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1200;
        allow update: if isAdmin() || (isNotBanned() && resource.data.authorUid == request.auth.uid);
        allow delete: if isSignedIn()
                      && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // Bandeja de comentarios en duda retenidos para moderación por el administrador
    match /adminPendingComments/{pendingId} {
      allow create: if isNotBanned()
                    && request.resource.data.commentText is string;
      allow read, update, delete: if isAdmin();
    }

    // Conexiones de confianza / amigos entre usuarios
    match /connections/{pairId} {
      allow get: if isSignedIn()
                 && (resource == null || request.auth.uid in resource.data.users);
      allow list: if isSignedIn()
                  && request.auth.uid in resource.data.users;
      allow create: if isNotBanned()
                    && request.resource.data.users is list
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requesterUid == request.auth.uid;
      allow update: if isNotBanned()
                    && request.auth.uid in resource.data.users
                    && request.resource.data.users == resource.data.users;
      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.users;
    }

    // Conversaciones cifradas con límite de 1 mensaje para desconocidos hasta aceptar
    match /conversations/{convId} {
      allow get: if isSignedIn()
                 && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if isNotBanned()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isNotBanned()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && (
                      request.resource.data.status == resource.data.status
                      || request.resource.data.status == "blocked"
                      || (
                        resource.data.status == "pending"
                        && request.resource.data.status == "accepted"
                        && (
                          request.auth.uid != resource.data.initiatorUid
                          || (
                            exists(/databases/$(database)/documents/connections/$(convId))
                            && get(/databases/$(database)/documents/connections/$(convId)).data.status == "accepted"
                          )
                        )
                      )
                    );

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isNotBanned()
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && request.resource.data.senderUid == request.auth.uid
                      && (
                        get(/databases/$(database)/documents/conversations/$(convId)).data.status == "accepted"
                        || (
                          get(/databases/$(database)/documents/conversations/$(convId)).data.status == "pending"
                          && (
                            get(/databases/$(database)/documents/conversations/$(convId)).data.messageCount < 1
                            || request.auth.uid != get(/databases/$(database)/documents/conversations/$(convId)).data.initiatorUid
                          )
                        )
                      );
      }
    }

    // Comunidades profesionales por especialidad
    match /communities/{commId} {
      allow read: if true;
      allow create, update: if isNotBanned();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if true;
        allow create: if isNotBanned()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2500;
        allow delete: if isSignedIn()
                      && (resource.data.senderUid == request.auth.uid || isAdmin());
      }
    }
  }
}
